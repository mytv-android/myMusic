<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+ 包可见性：查询系统语音识别服务与识别界面时要用 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- 应用内更新要解析到系统安装器，否则 startActivity 抛 ActivityNotFoundException -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".MyMusicApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyMusic"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">
        <!-- 解锁前被拉起的进程（开机、桌面组件、媒体键、adb 等）拿到的是设备加密（DE）存储上下文，
             WorkManager 在构造时检查到 isDeviceProtectedStorage 就直接抛异常，而它在
             androidx.startup.InitializationProvider 里、Application.onCreate 之前就执行，业务代码拦不住。
             关掉自动初始化，改由 MyMusicApp 实现 Configuration.Provider 在解锁后按需初始化。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- TCL 灵控桌面「我的应用」全幅卡片：306×196 的整卡图，应用名已烧进图里。
                 缓存键是 <包名>_<activity名>，换图后需 pm clear 才会刷新。 -->
            <meta-data
                android:name="beidouui_icon"
                android:value="tcl_launcher_card.png" />
        </activity>
        <!-- 桌面小组件的配置页（背景、榜单、歌单、听歌模式、歌词翻译）：添加时可跳过，长按组件重新进来 -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:enabled="@bool/widgets_enabled"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/widget_config_title"
            android:taskAffinity=""
            android:theme="@style/Theme.MyMusic">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- 进程不在时蓝牙耳机的播放键、Android 11+ 媒体控件的“继续播放”：拉起 PlaybackService 接上存下来的队列 -->
        <receiver
            android:name=".playback.ResumeButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- 桌面小组件（Glance）。全部由 App 推送，见 widget/WidgetUpdater。
             电视上没有桌面：组件在 MyMusicApp 启动时持久禁用（@bool/widgets_enabled 只是静态兜底，
             实测装 APK 时系统解析清单不看 uiMode）。禁用后系统不会拉起，Glance 和它依赖的
             WorkManager 也就不会被加载。 -->
        <receiver
            android:name=".widget.NowPlayingWidgetReceiver"
            android:enabled="@bool/widgets_enabled"
            android:exported="true"
            android:label="@string/widget_now_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_info" />
        </receiver>
        <receiver
            android:name=".widget.LyricsWidgetReceiver"
            android:enabled="@bool/widgets_enabled"
            android:exported="true"
            android:label="@string/widget_lyrics_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_lyrics_info" />
        </receiver>
        <receiver
            android:name=".widget.ModeWidgetReceiver"
            android:enabled="@bool/widgets_enabled"
            android:exported="true"
            android:label="@string/widget_mode_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mode_info" />
        </receiver>
        <receiver
            android:name=".widget.ChartWidgetReceiver"
            android:enabled="@bool/widgets_enabled"
            android:exported="true"
            android:label="@string/widget_charts_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_charts_info" />
        </receiver>
        <receiver
            android:name=".widget.ListWidgetReceiver"
            android:enabled="@bool/widgets_enabled"
            android:exported="true"
            android:label="@string/widget_list_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_list_info" />
        </receiver>
        <receiver
            android:name=".widget.ToolsWidgetReceiver"
            android:enabled="@bool/widgets_enabled"
            android:exported="true"
            android:label="@string/widget_tools_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tools_info" />
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
