<?xml version="1.0" encoding="utf-8"?>
<!-- 小组件刚放上桌面、App 还没推第一版内容时的占位：圆角底加品牌标记，不用 Glance 默认的转圈。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_loading_bg">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_w_brand_frame"
        android:tint="@color/widget_loading_ink" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_w_brand_note"
        android:tint="@color/widget_loading_ink" />
</FrameLayout>
